{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Kestrel": {
        "Endpoints": {
            "RestHttp": {
                "Url": "http://0.0.0.0:8080",
                "Protocols": "Http1"
            },
            "Grpc": {
                "Url": "http://0.0.0.0:8081",
                "Protocols": "Http2"
            }
        }
    },
    "Observability": {
        "ServiceName": "Todo.WebApi",
        "ServiceVersion": "1.0.0",
        "DeploymentEnvironment": "Production"
    },
    "OpenTelemetry": {
        "ExportEnabled": false,
        "Endpoint": "http://localhost:4317",
        "Protocol": "grpc",
        "Headers": "",
        "TraceSampler": "parentbased_traceidratio",
        "TraceSamplerArg": 1.0
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "postgresWrite": "",
        "postgresRead": ""
    },
    "Redis": {
        "ConnectionString": ""
    },
    "SignalR": {
        "UseRedisBackplane": true
    },
    "Jwt": {
        "Key": "",
        "Issuer": "AxesServiceServer",
        "Audience": "AxesClient",
        "Subject": "AxesServiceToken"
    }
}
